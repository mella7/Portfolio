# Copy to .env (never committed) for `npm start` and `npm run telegram`.
# On Netlify, set the same names under Project configuration > Environment variables.

# Passkey for /stats. Make one with: npm run passkey
STATS_TOKEN=

# Telegram (see README "Telegram updates")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
# REPORT_EVERY_DAYS=15
# NOTIFY_NEW_VISITORS=1
# NOTIFY_TIMEZONE=Europe/Berlin
# STATS_IP_DAYS=30
# PORT=8080
# TRUST_PROXY=1
