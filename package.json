{
  "name": "mella7-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Personal portfolio of Mohamed Ali Mellah. A static site with zero dependencies, plus visitor statistics as Netlify Functions or a small Node server.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && node scripts/check.mjs",
